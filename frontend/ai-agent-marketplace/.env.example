# AI Agent Marketplace Frontend - Environment Variables
# Copy this file to .env.local and fill in your values

# ========== REQUIRED ==========
# Deployed Soroban contract ID
VITE_CONTRACT_ID=CDXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Soroban RPC endpoint
VITE_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase (Testnet or Mainnet)
VITE_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# USDC Contract ID (Testnet or Mainnet)
# Testnet: CBIELSO6KZLFBUSGZ47QRYCYMHK4D2H5IMKBORJGUJVAVKZOQK4D7IAJ
# Mainnet: CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75
VITE_USDC_CONTRACT_ID=CBIELSO6KZLFBUSGZ47QRYCYMHK4D2H5IMKBORJGUJVAVKZOQK4D7IAJ

# ========== IPFS (for metadata & deliverable uploads) ==========
# IPFS pinning service API key.
#   Pinata (default):   create a JWT at https://app.pinata.cloud/developers/api-keys
#   web3.storage:       create a token at https://web3.storage (set VITE_IPFS_PROVIDER=web3storage)
VITE_IPFS_API_KEY=your_pinata_jwt_or_web3storage_token_here

# Pinning backend: "pinata" (default) or "web3storage"
VITE_IPFS_PROVIDER=pinata

# Public IPFS gateway used to build read-URLs from CIDs.
# Options:
#   https://ipfs.io/ipfs/          (public, rate-limited)
#   https://nftstorage.link/ipfs/  (fast, backed by NFT.Storage CDN)
#   https://cloudflare-ipfs.com/ipfs/
#   https://gateway.pinata.cloud/ipfs/
VITE_IPFS_GATEWAY=https://ipfs.io/ipfs/

# ========== OPTIONAL ==========
# Analytics
VITE_GA_ID=G-XXXXXXXXXX

# Sentry DSN for error tracking
VITE_SENTRY_DSN=https://xxxx@sentry.io/xxxx

# Feature flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_TESTNET_BANNER=true